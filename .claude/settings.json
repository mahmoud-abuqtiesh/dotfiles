          {
            "async": true,
            "command": "'/home/dev/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/dev/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo '{\"systemMessage\":\"Reminder: /rename this session to something memorable\"}'",
            "timeout": 2,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/home/dev/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/dev/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/dev/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/dev/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
